        ]
      },
      "children": [
        { "type": "element", "id": "heading", "tag": "h1", "children": [
          { "type": "text", "text": "海のそばで過ごす" }
        ] },
        { "type": "element", "id": "lead", "tag": "p", "children": [
          { "type": "text", "text": "同じ文書を複数の公開サイトで描画できます。" }
        ] },
        { "type": "element", "id": "link", "tag": "a", "attrs": { "href": "/about" }, "children": [
          { "type": "text", "text": "詳しく見る" }
        ] }
      ]
