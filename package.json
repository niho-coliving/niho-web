{
  "name": "@niho/web",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "description": "Versioned public page documents and shared React/server renderers",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./pages": {
      "types": "./dist/pages.d.ts",
      "import": "./dist/pages.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js"
    },
    "./projects": {
      "types": "./dist/projects.d.ts",
      "import": "./dist/projects.js"
    },
    "./project-editor": {
      "types": "./dist/project-editor-adapter.d.ts",
      "import": "./dist/project-editor-adapter.js"
    },
    "./project-manager": {
      "types": "./dist/project-manager.d.ts",
      "import": "./dist/project-manager.js"
    },
    "./project-directory": {
      "types": "./dist/project-directory.d.ts",
      "import": "./dist/project-directory.js"
    },
    "./project-dashboard": {
      "types": "./dist/project-dashboard.d.ts",
      "import": "./dist/project-dashboard.js"
    },
    "./project-read-model": {
      "types": "./dist/project-read-model.d.ts",
      "import": "./dist/project-read-model.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js"
    },
    "./localization": {
      "types": "./dist/localization.d.ts",
      "import": "./dist/localization.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "node examples/editor-demo.mjs",
    "demo:projects": "node examples/projects-demo.mjs",
    "demo:analytics": "node examples/analytics-demo.mjs",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  }
}
